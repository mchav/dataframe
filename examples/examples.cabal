    -- cabal-flag-driven CPP defines that the library uses.
    cpp-options:      -DWITH_CSV -DWITH_PARQUET -DWITH_TH -DWITH_LAZY -DWITH_CSV_TH -DWITH_PARQUET_TH
    build-depends:    base >= 4 && <5,
                      aeson >= 0.11.0.0 && < 3,
                      array >= 0.5.4.0 && < 0.6,
                      attoparsec >= 0.12 && < 0.16,
                      bytestring >= 0.11 && < 0.14,
                      bytestring-lexing >= 0.5 && < 0.7,
                      containers >= 0.6.7 && < 0.10,
                      directory >= 1.3.0.0 && < 2,
                      granite >= 0.6 && < 1,
                      hasktorch,
                      parallel >= 3.2 && < 4,
                      primitive >= 0.7 && < 0.11,
                      process ^>= 1.6,
                      snappy-hs >= 0.1 && < 0.3,
                      random >= 1.2 && < 2,
                      regex-tdfa >= 1.3.0 && < 2,
                      scientific >=0.3.1 && < 0.5,
                      template-haskell >= 2.0 && < 3,
                      text >= 2.1 && < 3,
                      time >= 1.12 && < 2,
                      vector >= 0.13 && < 0.15,
                      vector-algorithms >= 0.9 && < 0.11,
                      zlib >= 0.5 && < 1,
                      zstd >= 0.1.2.0 && < 0.3,
                      stm >= 2.5 && < 3,
