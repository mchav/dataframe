cabal-version:      2.4
name:               examples
version:            0.0.1.0

synopsis: Examples for dataframe library.

description: Examples for dataframe library.

bug-reports: https://github.com/mchav/dataframe/issues
license:            MIT
author:             Michael Chavinda
